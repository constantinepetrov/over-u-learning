# Copy to .env on the VM. Never put generated credentials in Git.
ERPNEXT_VERSION=version-16
CUSTOM_IMAGE=overu-app
CUSTOM_TAG=16
PULL_POLICY=never
RESTART_POLICY=unless-stopped
DB_PASSWORD_SECRETS_FILE=/srv/overu/private/db_root_password
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
FRAPPE_SITE_NAME_HEADER=overu.online
SITES_RULE=Host(`overu.online`)
LETSENCRYPT_EMAIL=admin@overu.online
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# Derived from frappe/frappe_docker images/layered/Containerfile.
ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_IMAGE_PREFIX=frappe

FROM ${FRAPPE_IMAGE_PREFIX}/build:${FRAPPE_BRANCH} AS builder
ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG CACHE_BUST=""

USER frappe
RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=0 \
  : "${CACHE_BUST}" && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS} \
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-assets \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  git clone https://github.com/frappe/payments.git apps/payments && \
  git -C apps/payments fetch https://github.com/frappe/payments.git cca07d9f9392e2ea0e521c5975151db9e4b6c321 && \
  git -C apps/payments checkout --detach cca07d9f9392e2ea0e521c5975151db9e4b6c321 && \
  git clone https://github.com/constantinepetrov/over-u-learning.git apps/lms && \
  git -C apps/lms fetch https://github.com/constantinepetrov/over-u-learning.git 73f9f3f4aef1f6ea2976e722ba1e757ba583e637 && \
  git -C apps/lms checkout --detach 73f9f3f4aef1f6ea2976e722ba1e757ba583e637 && \
  printf '{"socketio_port":9000}' > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

COPY --chown=frappe:frappe over-u/apps/over_u /home/frappe/frappe-bench/apps/over_u
COPY --chown=frappe:frappe over-u/dev/build-localized-frontend.mjs over-u/dev/localization-plugin.mjs /home/frappe/over-u/dev/
RUN cd /home/frappe/frappe-bench && \
  uv pip install -e apps/over_u --python env/bin/python && \
  ln -sfn /home/frappe/frappe-bench/apps/lms/frontend /home/frappe/frontend && \
  ln -sfn /home/frappe/frappe-bench/apps/lms /home/frappe/lms && \
  mkdir -p /home/frappe/frontend/node_modules/@framework && \
  rm -rf /home/frappe/frontend/node_modules/@framework/ui && \
  ln -s /home/frappe/frappe-bench/apps/frappe/ui /home/frappe/frontend/node_modules/@framework/ui && \
  bench build

FROM ${FRAPPE_IMAGE_PREFIX}/base:${FRAPPE_BRANCH} AS backend
USER frappe
COPY --from=builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench
RUN chmod -R g=u /home/frappe/frappe-bench
RUN cd /home/frappe/frappe-bench && \
  uv pip install -e apps/payments -e apps/lms --python env/bin/python
WORKDIR /home/frappe/frappe-bench
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets
VOLUME ["/home/frappe/frappe-bench/sites", "/home/frappe/frappe-bench/logs"]
USER root
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh
COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh
USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["start.sh"]

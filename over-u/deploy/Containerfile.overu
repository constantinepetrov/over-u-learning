# OVER U image, based on frappe/frappe_docker layered Containerfile.
# Every upstream source and base image is pinned in versions.lock.json.
ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_BUILD_IMAGE=frappe/build@sha256:e9139c9e399bc5d58b3f6e1988272f435eeb909163140eb735e4cc52697baa76
ARG FRAPPE_BASE_IMAGE=frappe/base@sha256:1a70d58dcd0d4b919b00626a458b07114efe005e077761daa516bd929fd5568d
ARG FRAPPE_COMMIT=2871914b69b6e14a4b023d9b7cc52dc3e269cc1b
ARG PAYMENTS_COMMIT=cca07d9f9392e2ea0e521c5975151db9e4b6c321
ARG LMS_COMMIT=ca30344786054949a7b7dc5ee6a5fd37fb8f812c
ARG FRAPPE_DOCKER_COMMIT=2b26e9ab8d751e5ea33bb7b930aea3550bb81ded
ARG SOURCE_REVISION=unknown

FROM ${FRAPPE_BUILD_IMAGE} AS builder
ARG FRAPPE_BRANCH
ARG FRAPPE_COMMIT
ARG PAYMENTS_COMMIT
ARG LMS_COMMIT
ARG FRAPPE_DOCKER_COMMIT
ARG FRAPPE_BUILD_IMAGE
ARG FRAPPE_BASE_IMAGE
ARG CACHE_BUST=""

USER frappe
RUN : "${CACHE_BUST}" && \
  bench init \
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=https://github.com/frappe/frappe \
    --no-procfile \
    --no-backups \
    --skip-assets \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  git -C apps/frappe fetch --depth=1 https://github.com/frappe/frappe.git "${FRAPPE_COMMIT}" && \
  git -C apps/frappe checkout --detach FETCH_HEAD && \
  git clone https://github.com/frappe/payments.git apps/payments && \
  git -C apps/payments fetch --depth=1 origin "${PAYMENTS_COMMIT}" && \
  git -C apps/payments checkout --detach FETCH_HEAD && \
  git clone https://github.com/constantinepetrov/over-u-learning.git apps/lms && \
  git -C apps/lms fetch --depth=1 origin "${LMS_COMMIT}" && \
  git -C apps/lms checkout --detach FETCH_HEAD && \
  printf '{"socketio_port":9000}' > sites/common_site_config.json && \
  find apps -mindepth 1 -path '*/.git' -type d -prune -exec rm -rf {} +

COPY --chown=frappe:frappe over-u/apps/over_u /home/frappe/frappe-bench/apps/over_u
COPY --chown=frappe:frappe over-u/dev/build-localized-frontend.mjs over-u/dev/localization-plugin.mjs /home/frappe/over-u/dev/
RUN cd /home/frappe/frappe-bench && \
  uv pip install -e apps/over_u -e apps/payments -e apps/lms --python env/bin/python && \
  printf 'frappe\npayments\nlms\nover_u\n' > sites/apps.txt && \
  ln -sfn /home/frappe/frappe-bench/apps/lms/frontend /home/frappe/frontend && \
  ln -sfn /home/frappe/frappe-bench/apps/lms /home/frappe/lms && \
  mkdir -p /home/frappe/frontend/node_modules/@framework && \
  rm -rf /home/frappe/frontend/node_modules/@framework/ui && \
  ln -s /home/frappe/frappe-bench/apps/frappe/ui /home/frappe/frontend/node_modules/@framework/ui && \
  bench build && \
  rm -rf sites/assets/lms sites/assets/over_u && \
  ln -s /home/frappe/frappe-bench/apps/lms/lms/public sites/assets/lms && \
  ln -s /home/frappe/frappe-bench/apps/over_u/over_u/public sites/assets/over_u && \
  test -f sites/assets/lms/frontend/index.html && \
  test -n "$(find sites/assets/lms/frontend/assets -maxdepth 1 -type f -name 'index-*.js' -print -quit)" && \
  test -f sites/assets/over_u/localization/editor-menu.js

FROM ${FRAPPE_BASE_IMAGE} AS backend
ARG SOURCE_REVISION
ARG FRAPPE_COMMIT
ARG PAYMENTS_COMMIT
ARG LMS_COMMIT
ARG FRAPPE_DOCKER_COMMIT
ARG FRAPPE_BUILD_IMAGE
ARG FRAPPE_BASE_IMAGE
USER frappe
COPY --from=builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench
RUN chmod -R g=u /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  test -f sites/assets/lms/frontend/index.html && \
  test -n "$(find sites/assets/lms/frontend/assets -maxdepth 1 -type f -name 'index-*.js' -print -quit)" && \
  test -f sites/assets/over_u/localization/editor-menu.js
WORKDIR /home/frappe/frappe-bench
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets
VOLUME ["/home/frappe/frappe-bench/sites", "/home/frappe/frappe-bench/logs"]
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
  io.overu.build.frappe.revision="${FRAPPE_COMMIT}" \
  io.overu.build.payments.revision="${PAYMENTS_COMMIT}" \
  io.overu.build.lms.revision="${LMS_COMMIT}" \
  io.overu.build.frappe-docker.revision="${FRAPPE_DOCKER_COMMIT}" \
  io.overu.build.frappe.build-image="${FRAPPE_BUILD_IMAGE}" \
  io.overu.build.frappe.base-image="${FRAPPE_BASE_IMAGE}"
USER root
COPY over-u/deploy/frappe-docker/main-entrypoint.sh /usr/local/bin/entrypoint.sh
COPY over-u/deploy/frappe-docker/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/start.sh
USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["start.sh"]
